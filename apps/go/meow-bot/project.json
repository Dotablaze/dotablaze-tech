{
  "name": "meow-bot",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/go/meow-bot",
  "tags": ["type:app", "scope:meow-bot", "language:go"],
  "targets": {
    "build": {
      "executor": "@nx-go/nx-go:build",
      "options": {
        "main": "{projectRoot}/main.go",
        "outputPath": "dist/apps/go/meow-bot/main"

      }
    },
    "serve": {
      "executor": "@nx-go/nx-go:serve",
      "options": {
        "main": "{projectRoot}/main.go"
      }
    },
    "test": {
      "executor": "@nx-go/nx-go:test"
    },
    "lint": {
      "executor": "@nx-go/nx-go:lint"
    },
    "tidy": {
      "executor": "@nx-go/nx-go:tidy"
    },
    "build-image": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "docker buildx build --platform linux/amd64,linux/arm64 -f {projectRoot}/Dockerfile -t dotablaze/meow-bot:latest -t dotablaze/meow-bot:{version} --push .",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "local-build-image": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "build"],
      "options": {
        "commands": [
          {
            "command": "docker buildx build -f {projectRoot}/Dockerfile.local -t dotablaze/meow-bot:latest --load .",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "serve-container": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "docker run --rm -p 9100:9100 dotablaze/meow-bot:latest",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "download": {
      "command": "go mod download"
    }
  }
}
